###########################################################
# Set the include-path according to the defined interface.
###########################################################

ccflags-y += -I$(src) -I$(src)/if -I$(src)/dev -I$(src)/if/v4l2 -I$(src)/external
ccflags-$(CONFIG_VIDEO_LINLON_FTRACE) += -DMVX_LOG_FTRACE_ENABLE
ccflags-$(CONFIG_VIDEO_LINLON_PRINT_FILE) += -DMVX_LOG_PRINT_FILE_ENABLE
ccflags-y += $(EXTRA_CCFLAGS)

###########################################################
# Define build targets and what files to include.
###########################################################

# Amvx module
# Use obj-m for out-of-tree DKMS builds, CONFIG_VIDEO_LINLON for in-tree
ifeq ($(CONFIG_VIDEO_LINLON),)
obj-m := amvx.o
else
# NCZ: do NOT build the in-tree amvx.ko.
#
# The VPU driver ships from the vendor as DKMS (cix-vpu-driver, dkms.conf sets
# DEST_MODULE_LOCATION=/updates and BUILT_MODULE_NAME=amvx), and the DKMS copy
# is NEWER than this in-tree snapshot: 1.0.2 carries the VP8 4096 frame-size fix
# and the NV12 decoder-capture default, neither of which is in this tree.
#
# Building both puts two same-named amvx.ko on the system. modprobe prefers
# updates/ over kernel/, so DKMS wins today - but if the DKMS build is ever
# skipped (its BUILD_EXCLUSIVE_KERNEL gate keys on CONFIG_ARCH_CIX) the system
# would silently fall back to THIS older driver, losing hardware GStreamer
# decode with no diagnostic.
#
# CONFIG_VIDEO_LINLON stays enabled deliberately: it is what selects
# VIDEOBUF2_DMA_SG / VIDEOBUF2_MEMOPS, which the DKMS amvx.ko links against
# (see modules.dep). Disabling the symbol removes videobuf2 and breaks the
# vendor driver.
# obj-$(CONFIG_VIDEO_LINLON) := amvx.o
endif

# Add objects for if module.
if-y := if/mvx_if.o \
	if/mvx_buffer.o \
	if/mvx_firmware_cache.o \
	if/mvx_firmware.o \
	if/mvx_firmware_v2.o \
	if/mvx_firmware_v3.o \
	if/mvx_mmu.o \
	if/mvx_secure.o \
	if/mvx_session.o

# Add external interface.
if-y += if/v4l2/mvx_ext_v4l2.o \
	if/v4l2/mvx_v4l2_buffer.o \
	if/v4l2/mvx_v4l2_session.o \
	if/v4l2/mvx_v4l2_vidioc.o \
	if/v4l2/mvx_v4l2_fops.o \
	if/v4l2/mvx_v4l2_ctrls.o

# Add objects for dev module.
dev-y := dev/mvx_dev.o \
	 dev/mvx_hwreg.o \
	 dev/mvx_hwreg_v500.o \
	 dev/mvx_hwreg_v550.o \
	 dev/mvx_hwreg_v61.o \
	 dev/mvx_hwreg_v52_v76.o \
	 dev/mvx_lsid.o \
	 dev/mvx_scheduler.o \
	 mvx_pm_runtime.o

# Add driver objects.
amvx-y := mvx_driver.o \
	  mvx_seq.o \
	  mvx_log.o \
	  mvx_log_group.o \
	  $(if-y) $(dev-y)
